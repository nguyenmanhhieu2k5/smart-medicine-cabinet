{
  "name": "smart-medicine-cabinet",
  "productName": "SmartMedicineCabinet",
  "version": "1.0.0",
  "description": "Tủ thuốc thông minh — ứng dụng desktop quản lý tủ thuốc, nhận diện thuốc bằng OCR, theo dõi nhiệt độ/độ ẩm qua ESP32",
  "private": true,
  "author": "Nhóm nghiên cứu Tủ thuốc thông minh",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "concurrently -k -n ui,app -c blue,green \"npm --prefix frontend run dev\" \"wait-on http-get://127.0.0.1:5173 && cross-env SMC_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "npm run build:frontend && electron .",
    "electron": "electron .",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "node scripts/build-backend.mjs",
    "check:resources": "node scripts/check-resources.mjs",
    "pack": "npm run build:frontend && npm run build:backend && npm run check:resources && electron-builder --dir",
    "dist": "npm run build:frontend && npm run build:backend && npm run check:resources && electron-builder --win nsis --x64",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node scripts/run-python.mjs -m pytest tests/backend",
    "test:frontend": "npm --prefix frontend run test",
    "test:desktop": "node tests/desktop/smoke.mjs",
    "lint": "npm --prefix frontend run lint && npm --prefix frontend run typecheck",
    "models": "node scripts/run-python.mjs scripts/download_ocr_models.py",
    "test:desktop:packed": "node tests/desktop/smoke.mjs --packed"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "vn.smartmedicinecabinet.app",
    "productName": "SmartMedicineCabinet",
    "copyright": "© 2026 Nhóm nghiên cứu Tủ thuốc thông minh",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "asar": true,
    "files": [
      "desktop/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/smc-backend",
        "to": "backend"
      },
      {
        "from": "data",
        "to": "data",
        "filter": [
          "DAV_unique.xlsx"
        ]
      },
      {
        "from": "ocr_models",
        "to": "ocr_models",
        "filter": [
          "**/*",
          "!**/.gitkeep",
          "!**/README*"
        ]
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tủ thuốc thông minh",
      "uninstallDisplayName": "Tủ thuốc thông minh",
      "artifactName": "SmartMedicineCabinet-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "npmRebuild": false,
    "publish": null
  }
}
