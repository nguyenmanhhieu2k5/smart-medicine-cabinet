# Danh sách biến môi trường TUỲ CHỌN (tài liệu tham khảo). Ứng dụng chạy được mà không cần biến nào.
# Lưu ý: ứng dụng đọc biến môi trường của hệ điều hành, KHÔNG tự đọc file .env.
# Electron tự đặt SMC_PORT / SMC_API_TOKEN / SMC_DATA_DIR / SMC_RESOURCE_DIR khi khởi động backend.
# KHÔNG ghi khoá thật vào mã nguồn; đặt biến môi trường Windows (System Properties -> Environment Variables).

# --- Đăng nhập Supabase (tuỳ chọn; để trống = ứng dụng chạy ở chế độ hồ sơ cục bộ, không có đăng nhập) ---
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=<anon key>

# --- Chỉ dùng khi phát triển ---
# SMC_DATA_DIR=D:\smc-data            # thư mục dữ liệu (mặc định %APPDATA%\SmartMedicineCabinet\data)
# SMC_CATALOG_XLSX=D:\DAV_unique.xlsx # file Excel danh mục mặc định
# SMC_OCR_MODEL_DIR=D:\ocr_models     # thư mục mô hình OCR
# SMC_PYTHON=C:\Python312\python.exe  # Python dùng để chạy backend ở chế độ dev
# SMC_PORT=8756                       # cổng backend khi chạy tay: python -m app.run
